{
  "name": "@leocavalcante/pi-tmux",
  "version": "0.1.6",
  "description": "Name your tmux window from your current Pi task and active session history with a short, lowercase AI summary.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leocavalcante/pi-tmux.git"
  },
  "keywords": ["pi-package", "pi", "tmux", "pi-extension", "coding-agent"],
  "files": ["index.ts", "src/", "README.md", "LICENSE"],
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "check:tests": "tsc -p tsconfig.test.json",
    "check:package": "publint",
    "test": "bun test tests/ && npm run test:node",
    "test:node": "node --test tests/tmux-node.mjs",
    "verify": "npm run check && npm run check:tests && npm run check:package && npm audit --audit-level=high && npm test && npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/bun": "^1.4.3",
    "@types/node": "22.20.5",
    "jiti": "2.7.0",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
