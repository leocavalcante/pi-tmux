{
  "name": "@leocavalcante/pi-tmux",
  "version": "0.0.0-development",
  "description": "Name tmux windows after your current Pi task and mark the ones waiting for your input.",
  "keywords": [
    "pi-extension",
    "pi-package",
    "pi-coding-agent",
    "tmux",
    "terminal",
    "terminal-multiplexer",
    "notifications",
    "productivity"
  ],
  "homepage": "https://github.com/leocavalcante/pi-tmux#readme",
  "bugs": {
    "url": "https://github.com/leocavalcante/pi-tmux/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leocavalcante/pi-tmux.git"
  },
  "license": "MIT",
  "author": "Leo Cavalcante (https://github.com/leocavalcante)",
  "type": "module",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json && tsc -p tests && tsc -p .github/scripts",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write . && eslint --fix .",
    "test": "bun run test:bun && bun run test:node",
    "test:bun": "bun test --timeout 30000",
    "test:node": "node --import jiti/register --test --test-concurrency=1 tests/*.node-test.ts",
    "changelog": "git-cliff --output CHANGELOG.md",
    "check:package": "bun run changelog && publint && node .github/scripts/check-package.mjs",
    "verify": "bun run lint && bun run check && bun run test && bun run check:package && bun audit --audit-level=high"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@eslint/js": "10.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "git-cliff": "2.14.2",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.19.0",
    "pi": ">=1.1.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
